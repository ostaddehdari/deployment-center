+\set ON_ERROR_STOP on
+BEGIN;
+SET LOCAL search_path TO zoha,public;
+
+-- v0.4: the versioned form is the presentation/layout source of truth.
+-- Runtime taxonomies/terms remain the canonical controlled-vocabulary source.
+ALTER TABLE index_form_fields DROP CONSTRAINT IF EXISTS index_form_fields_input_kind_check;
+ALTER TABLE index_form_fields ADD CONSTRAINT index_form_fields_input_kind_check CHECK(input_kind IN (
+  'text','textarea','richtext','number','boolean','date','time','datetime','email','phone','url','password','hidden',
+  'select','searchable_select','multiselect','radio','checkbox','tags','consent',
+  'file','reference','relation','repeater','group','duration','color','range','name','address',
+  'section','html','page'
+));
+
+DO $$
+DECLARE
+  rec record;
+  v_active integer;
+  v_draft integer;
+  id_active uuid;
+  id_draft uuid;
+BEGIN
+  FOR rec IN
+    SELECT ct.code AS content_type_code, f.id AS form_id, f.code AS form_code
+    FROM content_types ct
+    JOIN content_type_index_forms map
+      ON map.content_type_id=ct.id AND map.is_primary=true AND map.active=true AND map.deleted=false
+    JOIN index_forms f
+      ON f.id=map.index_form_id AND f.active=true AND f.deleted=false
+    WHERE ct.code IN ('mold','full_sermon','supporting')
+    ORDER BY ct.code
+  LOOP
+    SELECT COALESCE(max(version),0)+1 INTO v_active
+    FROM index_form_versions WHERE index_form_id=rec.form_id;
+    v_draft := v_active+1;
+
+    INSERT INTO index_form_versions(index_form_id,version,schema_snapshot,validation_rules,immutable,published_at,active,deleted)
+    VALUES(rec.form_id,v_active,jsonb_build_object('source','runtime-hybrid-v4','layout','grid','contentType',rec.content_type_code),'{}'::jsonb,true,now(),true,false)
+    RETURNING id INTO id_active;
+
+    INSERT INTO index_form_versions(index_form_id,version,schema_snapshot,validation_rules,immutable,active,deleted)
+    VALUES(rec.form_id,v_draft,jsonb_build_object('source','runtime-hybrid-v4','layout','grid','contentType',rec.content_type_code),'{}'::jsonb,false,true,false)
+    RETURNING id INTO id_draft;
+
+    INSERT INTO index_form_fields(
+      version_id,field_key,label,help_text,placeholder,input_kind,value_kind,required,search_enabled,index_enabled,
+      display_order,width,config,validation,active,deleted
+    )
+    SELECT
+      id_active,
+      lower(replace(t.code,'-','_')),
+      COALESCE(NULLIF(p.settings->>'label',''),t.title),
+      NULLIF(p.settings->>'helpText',''),
+      NULLIF(p.settings->>'placeholder',''),
+      CASE t.field_type
+        WHEN 'taxonomy' THEN 'searchable_select'
+        WHEN 'choice' THEN CASE WHEN t.is_multi THEN 'multiselect' ELSE 'select' END
+        WHEN 'chips' THEN 'tags'
+        WHEN 'relation' THEN 'relation'
+        WHEN 'textarea' THEN 'textarea'
+        WHEN 'text' THEN 'text'
+        ELSE 'text'
+      END,
+      CASE
+        WHEN t.field_type IN ('taxonomy','choice') AND t.is_multi THEN 'array'
+        WHEN t.field_type IN ('taxonomy','choice') THEN 'object'
+        WHEN t.field_type='chips' THEN 'array'
+        WHEN t.field_type='relation' THEN 'reference'
+        ELSE 'string'
+      END,
+      p.is_required,
+      true,
+      true,
+      p.sort_order,
+      CASE WHEN COALESCE(p.settings->>'width','') ~ '^[0-9]+$' AND (p.settings->>'width')::integer BETWEEN 25 AND 100 THEN (p.settings->>'width')::integer ELSE 100 END,
+      COALESCE(p.settings,'{}'::jsonb) || jsonb_build_object(
+        'runtime',jsonb_build_object(
+          'sourceMode',CASE WHEN t.field_type IN ('taxonomy','choice') THEN 'runtime_taxonomy' ELSE 'none' END,
+          'taxonomyCode',t.code,
+          'runtimeFieldType',t.field_type,
+          'allowsPersonal',t.allows_personal,
+          'parentTaxonomyCode',CASE t.code WHEN 'IDX-002' THEN 'IDX-001' WHEN 'IDX-006' THEN 'IDX-005' WHEN 'IDX-008' THEN 'IDX-007' WHEN 'IDX-010' THEN 'IDX-009' ELSE NULL END
+        )
+      ),
+      '{}'::jsonb,
+      true,false
+    FROM index_runtime_post_type_fields p
+    JOIN index_runtime_taxonomies t ON t.code=p.taxonomy_code
+    WHERE p.post_type_code=rec.content_type_code AND t.is_active
+    ORDER BY p.sort_order,t.code;
+
+    INSERT INTO index_form_fields(
+      version_id,field_key,label,help_text,placeholder,input_kind,value_kind,required,search_enabled,index_enabled,
+      display_order,width,config,validation,active,deleted
+    )
+    SELECT
+      id_draft,field_key,label,help_text,placeholder,input_kind,value_kind,required,search_enabled,index_enabled,
+      display_order,width,config,validation,true,false
+    FROM index_form_fields
+    WHERE version_id=id_active AND active=true AND deleted=false
+    ORDER BY display_order,id;
+
+    UPDATE index_forms
+    SET active_version=v_active,draft_version=v_draft,
+        settings=COALESCE(settings,'{}'::jsonb) || '{"builder":"runtime-hybrid-v4"}'::jsonb,
+        updated_at=now(),update_at=now()
+    WHERE id=rec.form_id;
+  END LOOP;
+END $$;
+
+INSERT INTO schema_migrations(version,checksum)
+VALUES('180_hybrid_runtime_index_builder','runtime-hybrid-v4-direct-source')
+ON CONFLICT(version) DO NOTHING;
+
+COMMIT;
