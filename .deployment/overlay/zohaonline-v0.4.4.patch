+  <label v-else-if="f.type==='boolean'||f.type==='consent'" class="boolean"><input type="checkbox" :checked="Boolean(modelValue)" @change="emit('update:modelValue',checkedValue($event))"><span>{{placeholder||f.title}}</span></label>
